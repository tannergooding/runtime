<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>$(NetCoreAppCurrent)</TargetFramework>
    <IsPartialFacadeAssembly>true</IsPartialFacadeAssembly>
    <!-- ApiCompat cannot currently validate a facade whose forwarded types have multiple destinations. -->
    <ApiCompatValidateAssemblies>false</ApiCompatValidateAssemblies>
    <!-- GenFacades emits extern aliases before its auto-generated marker. -->
    <NoWarn>$(NoWarn);IDE0073</NoWarn>
    <UseCompilerGeneratedDocXmlFile>false</UseCompilerGeneratedDocXmlFile>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="$(CommonPath)System\Experimentals.cs" Link="Common\System\Experimentals.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(CoreLibProject)" />
    <ProjectReference Include="..\..\System.Numerics.Vectors\src\System.Numerics.Vectors.csproj" ReferenceOutputAssembly="false" />
    <SeedTypePreference Include="System.Runtime.Intrinsics.Vector128" Aliases="numericsvectors" />
  </ItemGroup>

  <Target Name="AddNumericsVectorsFacadeReference" BeforeTargets="GeneratePartialFacadeSource">
    <ItemGroup>
      <ReferencePathWithRefAssemblies Include="$(ArtifactsBinDir)System.Numerics.Vectors\$(Configuration)\$(TargetFramework)\System.Numerics.Vectors.dll"
                                      Aliases="numericsvectors" />
    </ItemGroup>
  </Target>

</Project>